# Azure OpenAI Configuration (Option 1)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1
AZURE_AI_API_KEY=

# Fast entry/triage agent — used for the router that decides whether to hand off.
AZURE_AI_FAST_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano
# Powerful deep-analysis agent — used for DAX generation, multi-step reasoning.
AZURE_AI_DEEP_MODEL_DEPLOYMENT_NAME=gpt-5.4-pro

# Power BI Configuration (Auto-generates tokens using Azure CLI auth)
# Option 1: Let the app generate tokens automatically (Recommended)
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_WORKSPACE_ID=

# Development Settings
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000